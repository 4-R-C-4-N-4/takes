{
  "name": "takes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc -b && pnpm check:web",
    "check:web": "pnpm --filter @takes/web check",
    "test": "vitest run",
    "build:rulesets": "node --experimental-strip-types packages/library/scripts/build-rulesets.ts",
    "server:start": "pnpm --filter @takes/server start",
    "serve": "pnpm --filter @takes/web build && WEB_DIST=apps/web/dist pnpm --filter @takes/server start"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ws": "^8.22.0"
  }
}
